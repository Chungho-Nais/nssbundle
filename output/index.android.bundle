LECT SPEC_DTAL\n     FROM WORK_M\n     WHERE CONT_NUMB = ?\n       AND ACCT_DATE = ?\n       AND ACCT_SEQN = ?\n       AND USER_ID = ?\n    ",e.SELECT_WORK_M_ENGINEER="SELECT SUEN_STCD\n     FROM WORK_M\n     WHERE CONT_NUMB = ?\n       AND ACCT_DATE = ?\n       AND ACCT_SEQN = ?\n       AND USER_ID = ?\n    ",e.UPDATE_WORK_M_SPEC="UPDATE WORK_M SET\n        SPEC_DTAL = ?\n     WHERE CONT_NUMB = ?\n       AND ACCT_DATE = ?\n       AND ACCT_SEQN = ?\n       AND USER_ID = ?\n    ",e.SELECT_WORK_M="SELECT *\n     FROM WORK_M\n     WHERE TRAN_YN = 'N'\n       AND CONT_NUMB = ?\n       AND ACCT_DATE = ?\n       AND ACCT_SEQN = ?\n       AND USER_ID = ?\n    ;",e.SELECT_PROCESS_DATA="SELECT *\n     FROM PROC_RSLT_M\n     WHERE CONT_NUMB = ?\n       AND ACCT_DATE = ?\n       AND ACCT_SEQN = ?\n    ;",e.SELECT_PROCESS_DATA_TARGET="SELECT *\n     FROM PROC_RSLT_M\n     WHERE CONT_NUMB = ?\n    ;",e.SELECT_PROCESS_DATA_TARGET_ACCOUNT="SELECT *\n     FROM PROC_RSLT_M\n     WHERE CONT_NUMB = ?\n    ;",e.SELECT_IMAGE_DATA="SELECT *\n     FROM TB_AS_IMAGE\n     WHERE P_CONT_NUMB = ?\n       AND P_ACCT_DATE = ?\n       AND P_ACCT_SEQN = ?;",e.INSERT_IMAGE_DATA="REPLACE INTO TB_AS_IMAGE (\n        P_FILE_IDXX, P_FILE_NAME, P_FILE_TYPE, P_FILE_SIZE, P_RLAT_DIVS, P_CONT_NUMB, P_ACCT_DATE, P_ACCT_SEQN, P_PROC_DIVS, P_INPT_PRSN, P_FILE_SRC\n    )\n     values (?,?,?,?,?,?,?,?,?,?,?);\n    ",e.DELETE_IMAGE_DATA="DELETE FROM TB_AS_IMAGE\n     WHERE P_CONT_NUMB = ?\n       AND P_ACCT_DATE = ?\n       AND P_ACCT_SEQN = ?\n       AND P_FILE_IDXX = ?;\n    ",e.DELETE_IMAGE_DATA_ALL="DELETE FROM TB_AS_IMAGE\n    ",e.SELECT_PROCESSING_PARTS="SELECT PART_CODE, PART_NAME, PART_PRIC, FLTR_STNM, BDCA_CHEK, MCLS_CODE, GB, BARC_YYNN,NACS_YYNN\n     FROM PROD_PART_CODE\n     WHERE USED_YYNN = 'Y'\n       AND (PROD_CODE = ? OR PROD_CODE = '0000000')\n       AND PART_CODE LIKE ?\n       AND PART_NAME LIKE ?\n       AND GB LIKE ?\n       AND INST_FLAG LIKE ?\n     ORDER BY PROD_CODE, PART_CODE;\n    ",e.SELECT_PROCESSING_PARTS_SINGLE="SELECT PART_CODE, PART_NAME, PART_PRIC, FLTR_STNM, BDCA_CHEK, MCLS_CODE, GB, BARC_YYNN,NACS_YYNN\n     FROM PROD_PART_CODE\n     WHERE USED_YYNN = 'Y'\n       AND (PROD_CODE = ? OR PROD_CODE = '0000000')\n       AND PART_CODE LIKE ?\n     ORDER BY PROD_CODE, PART_CODE;\n    ",e.SELECT_PROD_CODE="SELECT DISTINCT PROD_NAME, PROD_CODE FROM PROD_CODE WHERE PROD_CODE = ? AND USED_YYNN = ?;",e.INSERT_PARTS="REPLACE INTO PROC_RSLT_M\n     (\n         CONT_NUMB,\n         PART_CODE,\n         PART_NAME,\n         PART_PRIC,\n         NOMY_FLAG,\n         NOMY_RESN,\n         DISC_RESN,\n         PROC_AMNT ,\n         DISC_AMNT ,\n         DCRQ_AMNT ,\n         PROC_QNTY ,\n         BDCA_CODE ,\n         WATR_PRES ,\n         ACCT_DATE ,\n         MCLS_CODE ,\n         FLTR_STNM ,\n         GB,\n         ACCT_SEQN,\n         BAR_CODE,\n         NACS_BAR_CODE,\n         FILE_UPYN\n     )\n     VALUES(\n               ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?\n           );\n    ",e.UPDATE_PROC_RSLT_M_PARTS="UPDATE PROC_RSLT_M SET\n                            DISC_AMNT = ?,\n                            DISC_RESN = ?,\n                            NOMY_FLAG = ?,\n                            NOMY_RESN = ?,\n                            PART_PRIC = ?,\n                            PROC_AMNT = ?\n     WHERE CONT_NUMB = ?\n       AND PART_CODE = ?;\n    ",e.UPDATE_PROC_RSLT_M_BARCODE="UPDATE PROC_RSLT_M SET\n        BAR_CODE = ?\n     WHERE CONT_NUMB = ?\n       AND PART_CODE = ?;\n    ",e.SELECT_PARTS_PROCESSING_TAP="SELECT CONT_NUMB, PART_CODE, PART_NAME, PART_PRIC, NOMY_FLAG, NOMY_RESN,\n            DISC_RESN, PROC_AMNT , DISC_AMNT , DCRQ_AMNT , PROC_QNTY , BDCA_CODE , ACCT_DATE , MCLS_CODE , FLTR_STNM , GB, ACCT_SEQN, BAR_CODE, NACS_BAR_CODE\n     FROM PROC_RSLT_M\n     WHERE CONT_NUMB = ?",e.DELETE_PROC_RSLT_M="DELETE\n     FROM PROC_RSLT_M\n     WHERE CONT_NUMB = ?\n    ",e.DELETE_PROC_RSLT_M_PART_CODE="DELETE\n     FROM PROC_