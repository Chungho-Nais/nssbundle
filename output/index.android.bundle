E CONT_NUMB = ?\n          AND ACCT_DATE = ?\n          AND ACCT_SEQN = ?\n          AND PROC_CODE = ?\n    ",e.INSERT_PROC_RSLT_S_VISIT_SUSPENSE_CODE="\n        INSERT INTO PROC_RSLT_S\n        (\n            CONT_NUMB, ACCT_DATE, ACCT_SEQN, PROC_CODE, PART_CODE, PART_NAME\n        )\n        values (\n                   ?, ?, ?, ?, ?, ?\n               )\n    ",e.DELETE_PROC_RSLT_S_VISIT_SUSPENSE_CODE="\n        DELETE FROM PROC_RSLT_S\n        WHERE CONT_NUMB = ?\n          AND ACCT_DATE = ?\n          AND ACCT_SEQN = ?\n          AND PROC_CODE = ?;\n    ",e.DELETE_PROC_RSLT_S_PART_CODE="\n        DELETE FROM PROC_RSLT_S\n        WHERE CONT_NUMB = ?\n          AND ACCT_DATE = ?\n          AND ACCT_SEQN = ?\n          AND PROC_CODE = ?\n          AND PART_CODE = ?;\n    ",e.TEST_DELETE_PROC_RSLT_S_VISIT_SUSPENSE_CODE="\n        DELETE FROM PROC_RSLT_S;\n    ",e.SELECT_PROC_LIST="\n      SELECT * FROM PROC_RSLT_M\n      WHERE CONT_NUMB = ?;\n    "},1893,[]);
